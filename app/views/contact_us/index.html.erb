<div class="parent_container">
  <div class="container">
<br>
<br>
<br>
<br>
<br>
<% if flash.any? %>
<div class="alert_container">
  <p class="alert_text">
    <%== flash[:message] %>
  </p>
</div>
<%end%>
    <div class="wrapper animated bounceInLeft">
      <div class="company-info">

      </div>
      <div class="contact">
        <h3>Email Us</h3>
        <%= form_for(@enquiry, url: '/enquiry', method: :post, html: {class: 'form'}) do |f| %>
          <p>
            <label>Name</label>
            <%= f.text_field :name, required: true %>
          </p>
          <p>
            <label>Company</label>
            <%= f.text_field :company, required: true %>
          </p>
          <p>
            <label>Email Address</label>
            <%= f.text_field :email, required: true %>
          </p>
          <p>
            <label>Phone Number</label>
            <%= f.telephone_field :phone_number, required: true %>
          </p>
          <p class="full">
            <label>Message</label>
            <%= f.text_area :message, maxlength: 2000, rows: 5, required: true %>
          </p>
          <p class="full">
            <%= f.submit "Submit", class: "button" %>
          </p>
        <% end %>
      </div>
    </div>
  </div>
</div>