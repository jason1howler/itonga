<body id="top">

  <!-- 
    - #ALERT
  -->

  <!-- 
    - #HEADER
  -->
  <main>
    <article>
      <!-- 
        - #HERO
      -->
      <section class="hero" id="home">
        <div class="container">
          <div class="hero-content">
            <p class="hero-subtitle">Itonga</p>
            <h2 class="h2 hero-title">Placements Made Powerful Where legal expertise meets human understanding.</h2>
            <p class="hero-text">Talent solutions that protect, empower, and elevate your practice.</p>
            
          </div>
          <figure class="hero-banner">
            <%= image_tag "searching.png", width: 700, height: 532, loading: "lazy", alt: "search", class: "w-100 banner-animation" %>
          </figure>
        </div>
      </section>
      <!-- 
        - #ABOUT
      -->
      <section class="section about" id="about">
        <div class="container">
          <figure class="about-banner">
            <img src="https://github.com/codewithsadee/desinic/blob/master/assets/images/about-banner.png?raw=true" width="700" height="532" loading="lazy" alt="about banner" class="w-100 banner-animation" />
          </figure>
          <div class="about-content">
            <h2 class="h2 section-title underline">Why Us?</h2>
            <p class="about-text"> ITonga Resourcing is a specialist recruitment and HR consulting firm. We connect businesses across South Africa with exceptional professionals in IT, Legal, Finance, HR, and Operations — permanently and on contract.</p>
            <ul class="stats-list">
              <li class="stats-card">
                <p class="h3 stats-title">1875</p>
                <p class="stats-text">Clients Satisfied Clients</p>
              </li>
              <li class="stats-card">
                <p class="h3 stats-title">24/7</p>
                <p class="stats-text">Real Time Support</p>
              </li>
              <li class="stats-card">
                <p class="h3 stats-title">100%</p>
                <p class="stats-text">Guarantee</p>
              </li>
            </ul>
          </div>
        </div>
      </section>
      <!-- 
        - #SERVICE
      -->
      <section class="section service" id="services">
        <div class="container">
          <h2 class="h2 section-title underline">Recruitment done with precision and care</h2>
          <ul class="service-list">
            <li>
              <div class="service-card">
                <div class="card-icon">
                  <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#fff">
                    <path d="M15 4V2M15 4V6M15 4H10.5M3 10V19C3 20.1046 3.89543 21 5 21H19C20.1046 21 21 20.1046 21 19V10H3Z" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M3 10V6C3 4.89543 3.89543 4 5 4H7" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M7 2V6" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M21 10V6C21 4.89543 20.1046 4 19 4H18.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <h3 class="h3 title">Boutique & accountable.</h3>
                <p class="text">You deal directly with experienced recruiters — not junior coordinators. Every mandate gets senior attention.</p>
              </div>
            </li>
            <li>
              <div class="service-card">
                <div class="card-icon">
                  <svg width="24px" height="24px" viewBox="0 0 24 24" stroke-width="1.5" fill="none" xmlns="http://www.w3.org/2000/svg" color="#fff">
                    <path d="M22 4.6V17.4C22 17.7314 21.7314 18 21.4 18H2.6C2.26863 18 2 17.7314 2 17.4V4.6C2 4.26863 2.26863 4 2.6 4H21.4C21.7314 4 22 4.26863 22 4.6Z" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M8.5 21.5L12 18L15.5 21.5" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 2V4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M9 12V14" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 10V14" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M15 8V14" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <h3 class="h3 title">Broad yet specialist</h3>
                <p class="text">We cover IT, Legal, Finance, HR, and Operations — meaning you can consolidate your recruitment needs with one trusted partner.</p>
              </div>
            </li>
            <li>
              <div class="service-card">
                <div class="card-icon">
                  <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#fff">
                    <path d="M10 9H6" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M15.5 11C14.1193 11 13 9.88071 13 8.5C13 7.11929 14.1193 6 15.5 6C16.8807 6 18 7.11929 18 8.5C18 9.88071 16.8807 11 15.5 11Z" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M6 6H9" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M18 18L13.5 15L11 17L6 13" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M3 20.4V3.6C3 3.26863 3.26863 3 3.6 3H20.4C20.7314 3 21 3.26863 21 3.6V20.4C21 20.7314 20.7314 21 20.4 21H3.6C3.26863 21 3 20.7314 3 20.4Z" stroke="#fff" stroke-width="1.5"></path>
                  </svg>
                </div>
                <h3 class="h3 title">Permanent & contract</h3>
                <p class="text">Whether you need a long-term hire or a specialist contractor, we have the network and process to deliver — fast.</p>
              </div>
            </li>
          </ul>
        </div>
      </section>
      <!-- 
        - #FEATURES
      -->
      <section class="section features" id="features">
        <div class="container">
          <h2 class="h2 section-title underline">Sectors We Serve</h2>
          <ul class="features-list">
            <li>
              <div class="features-card">
                <div class="icon">
                  <ion-icon name="bulb-outline"></ion-icon>
                </div>
                <div class="content">
                  <h3 class="h3 title">Technology & IT</h3>
                  <p class="text">Placing developers, analysts, architects, and PMs into product companies, consultancies, financial services firms, and enterprise IT departments across South Africa.</p>
                </div>
              </div>
            </li>
            <li>
              <div class="features-card">
                <div class="icon">
                  <ion-icon name="color-palette-outline"></ion-icon>
                </div>
                <div class="content">
                  <h3 class="h3 title">Legal & Compliance</h3>
                  <p class="text">Recruiting qualified legal professionals into law firms, in-house legal departments, financial institutions, and regulated industries</p>
                </div>
              </div>
            </li>
          </ul>
          <figure class="features-banner">
            <img src="https://raw.githubusercontent.com/codewithsadee/desinic/master/assets/images/feautres-banner.png" width="369" height="318" loading="lazy" alt="Features Banner" class="w-100 banner-animation" />
          </figure>
          <ul class="features-list">
            <li>
              <div class="features-card">
                <div class="icon">
                  <ion-icon name="code-slash-outline"></ion-icon>
                </div>
                <div class="content">
                  <h3 class="h3 title">HR Consulting & People Advisory</h3>
                  <p class="text"> From transactional finance roles to strategic CFO appointments — we place finance talent for businesses at every stage of growth across all industries.</p>
                </div>
              </div>
            </li>
            <li>
              <div class="features-card">
                <div class="icon">
                  <ion-icon name="rocket-outline"></ion-icon>
                </div>
                <div class="content">
                  <h3 class="h3 title">Operations & Support</h3>
                  <p class="text">Strong operational teams are the backbone of every business. We recruit across administrative, operational, and support functions — reliable people who keep things running.</p>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </section>
      <!-- 
        - #BLOG
      -->
    </article>
  </main>
  <!-- 
    - #FOOTER
  -->
  <!-- 
    - #GO TO TOP
  -->
  <a href="#top" class="go-top active" aria-label="Go To Top" data-go-top>
    <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000">
      <path d="M12 22C10.8954 22 10 21.1046 10 20C10 18.8954 10.8954 18 12 18C13.1046 18 14 18.8954 14 20C14 21.1046 13.1046 22 12 22Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M12 15L12 2M12 2L15 5M12 2L9 5" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</body>