<!DOCTYPE html>
<html>
  <head>
    <title>AllTimeServices</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0;">


    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
  <% if flash.any? %>
    <div class="alert_container">
      <p class="alert_text">
        <%== flash[:message] %>
      </p>
    </div>
  <%end%>
  <header class="header" data-header>
  <div class="container">
    <div class="overlay" data-overlay></div>

    <a style="width: 50%;" href="/">
      <%= image_tag "itongalogo.png", style: "width: 15%;",class: 'logo', alt: "Company Logo" %>
    </a>

    <nav class="navbar" data-navbar>
      <div class="navbar-top">
        <a href="/" class="logo">Itonga</a>

        <button
          class="nav-close-btn"
          aria-label="Close Menu"
          data-nav-close-btn
        >
          
          <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000"><path d="M6.75827 17.2426L12.0009 12M17.2435 6.75736L12.0009 12M12.0009 12L6.75827 6.75736M12.0009 12L17.2435 17.2426" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>


    </nav>

    <a href="/contact_us" class="btn">
      
      <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#fff"><path d="M4 14C2.89543 14 2 13.1046 2 12C2 10.8954 2.89543 10 4 10C5.10457 10 6 10.8954 6 12C6 13.1046 5.10457 14 4 14Z" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9 12H22M22 12L19 9M22 12L19 15" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>

      <span style="
      width: 100%;">Get In Touch</span>
    </a>

    <button class="nav-open-btn" aria-label="Open Menu" data-nav-open-btn>
      
      <svg width="34px" height="34px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000">
      <path d="M3 5H11" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      </path><path d="M3 12H16" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      </path><path d="M3 19H21" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      </path></svg>
    </button>
  </div>
</header>
    <%= yield %>
    <footer class="footer">
    <div class="footer-top section">
      <div class="container">
        <div class="footer-brand">
          <a href="/" class="logo">Itonga</a>

          <p class="text">
         Specialist recruitment and HR consulting across IT, Legal, Finance, HR, and Operations. South Africa's boutique talent partner for businesses that take people seriously.
          </p>

          <ul class="social-list">
            <li>
              <a href="#" class="social-link">
                <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000"><path d="M21 8V16C21 18.7614 18.7614 21 16 21H8C5.23858 21 3 18.7614 3 16V8C3 5.23858 5.23858 3 8 3H16C18.7614 3 21 5.23858 21 8Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M11 21C11 18 11 15 11 12C11 9.8125 11.5 8 15 8" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9 13H11H15" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </li>

            <li>
              <a href="#" class="social-link">
                <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000"><path d="M12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M3 16V8C3 5.23858 5.23858 3 8 3H16C18.7614 3 21 5.23858 21 8V16C21 18.7614 18.7614 21 16 21H8C5.23858 21 3 18.7614 3 16Z" stroke="#000000" stroke-width="1.5"></path><path d="M17.5 6.51L17.51 6.49889" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </li>

            <li>
              <a href="#" class="social-link">
                <svg width="24px" height="24px" stroke-width="1.5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" color="#000000"><path d="M23 3.01006C23 3.01006 20.9821 4.20217 19.86 4.54006C19.2577 3.84757 18.4573 3.35675 17.567 3.13398C16.6767 2.91122 15.7395 2.96725 14.8821 3.29451C14.0247 3.62177 13.2884 4.20446 12.773 4.96377C12.2575 5.72309 11.9877 6.62239 12 7.54006V8.54006C10.2426 8.58562 8.50127 8.19587 6.93101 7.4055C5.36074 6.61513 4.01032 5.44869 3 4.01006C3 4.01006 -1 13.0101 8 17.0101C5.94053 18.408 3.48716 19.109 1 19.0101C10 24.0101 21 19.0101 21 7.51006C20.9991 7.23151 20.9723 6.95365 20.92 6.68006C21.9406 5.67355 23 3.01006 23 3.01006Z" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </a>
            </li>
          </ul>
        </div>


        <ul class="footer-list">
          <li>
            <p class="footer-list-title">Our Services</p>
          </li>

          <li>
            <a href="#services" class="footer-link">Talent Placement</a>
          </li>

          <li>
            <a href="#services" class="footer-link">Small Business Financial Design</a>
          </li>

          <li>
            <a href="#services" class="footer-link">Stress-Free Compliance</a>
          </li>
        </ul>


        <ul class="footer-list">
          <li>
            <p class="footer-list-title">Contact Us</p>
          </li>

          <li class="footer-item">
            <div class="footer-item-icon">
              <ion-icon name="call"></ion-icon>
            </div>

            <div>
              <a href="#" class="footer-item-link"
                >+27 710142490</a
              >
            </div>
          </li>

          <li class="footer-item">
            <div class="footer-item-icon">
              <ion-icon name="mail"></ion-icon>
            </div>

            <div>
              <a href="#" class="footer-item-link"
                >Admin@itongaresourcing.co.za</a
              >
              <a href="#" class="footer-item-link"
                >Recruitment@itongaresourcing.co.za</a
              >
            </div>
          </li>

          <li class="footer-item">
            <div class="footer-item-icon">
              <ion-icon name="location"></ion-icon>
            </div>

            <address class="footer-item-link">
              Caron Street, Rembrandt Park, Johannesburg, South Africa
            </address>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; 2026 <a href="#" class="copyright-link">ARGO Creatives</a>. All
        Right Reserved
      </p>
    </div>
  </footer>
  </body>
</html>
